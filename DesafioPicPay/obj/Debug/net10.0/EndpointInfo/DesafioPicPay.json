            "$ref": "#/components/schemas/TipoEntidade"
          }
        },
        "additionalProperties": false
      },
      "CarteiraResponseDto": {
        "type": "object",
        "properties": {
          "nomeCompleto": {
            "type": "string",
            "nullable": true
          },
          "cpfcnpj": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "saldoConta": {
            "type": "number",
            "format": "double"
